{
  "language": "en",
  "types": ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"],
  "scopes": ["auth", "api", "ui", "db", "ci", "deps"],
  "maxHeaderLength": 72,
  "hardHeaderLength": 80,
  "ticket": {
    "provider": "jira",
